CHAIN_ID=11155111
USDC_ADDRESS=0xcc194e1a843B658526D0D5C431f670028582Ae17
NODE_URL=https://devnode.telegraphprotocol.com
# Human-readable date is fine ("January 1, 2026" / "2026-01-01"); pinned to UTC midnight.
MODEL_CUTOFF=January 1, 2026
# Both values are plain USDC (not 6-decimal atomic units). Prices are only disclosed
# in the 402 challenge at call time, so MAX_PRICE is the shield against a mispriced miner.
BUDGET_CAP_USDC=2
MAX_PRICE_PER_CALL_USDC=0.10
# Optional: a miner to try before the leaderboard (our choice, recorded as such). 7314 is the team's
# package-release miner. Leave empty to buy by rank only.
PREFERRED_MINER_ID=
# --- secrets ---
TELEGRAPH_EVM_PRIVATE_KEY=
GH_PAT=fine-grained-token-with-repo-push-on-telegraph-pr-agent
LLM_API_KEY=key-for-hosted-llm
LLM_BASE_URL=https://your-hosted-llm-endpoint
# --- target repo (bot repo doubles as demo repo) ---
DEMO_REPO=borodedamie/telegraph-pr-agent
