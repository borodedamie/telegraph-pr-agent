  "dependencies": {
    "@actions/core": "^3.0.1",
    "@renovatebot/pep440": "^4.2.4",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "name": "lynx-review-action",
  "version": "1.0.0",
  "description": "Reusable GitHub Action built with TypeScript",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "build:prod": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --minify --outfile=dist/index.js"
  },
  "engines": {
    "node": ">=24"
  }
}
