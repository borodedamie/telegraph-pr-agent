# Copy to miner/.env (gitignored). Never commit real values.

# Shared secret Telegraph sends in X-Telegraph-Key; installed on the node after registration
MINER_API_KEY=
# Fine-grained GitHub token, public repositories read-only; lifts the 60 requests/hour limit
GITHUB_TOKEN=
# Upstash Redis (Vercel Marketplace); leave empty locally to use the in-memory cache
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Telegraph node the miner buys LLM calls from
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
# Spend wallet private key (test USDC only, small balance); never the payout wallet
MINER_SPEND_KEY=
# Ordered LLM miners, <minerId>:<method>:<path>; empty = rules-only extraction, buys nothing
LLM_MINERS=302:POST:/gen,7413:GET:/language-generation

# Bump when prompts, LLM miners or the output schema change (part of every cache key)
PROCESSING_VERSION=p3

# Budget overrides (research R9 defaults)
MAX_SOURCE_REQUESTS=25
MAX_TIME_MS=20000
LOCK_WAIT_MS=5000
MAX_MODEL_CALLS=1
MAX_MODEL_INPUT_CHARS=24000
MAX_MODEL_COST_USDC=0.01
LLM_TIMEOUT_MS=12000
MAX_MODEL_RELEASES=20
MAX_RELEASES=50

# Origin abuse limits (research R10)
ORIGIN_RATE_PER_MIN=120
MAX_CONCURRENT_COMPUTE=4

# Forces temporarily_unavailable; set only for the paid not-charged test (T063)
SIMULATE_UPSTREAM_OUTAGE=
